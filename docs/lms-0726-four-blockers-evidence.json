  "helpers": [
    {
      "name": "private.current_user_can_manage_team(uuid)",
      "definition": "CREATE OR REPLACE FUNCTION private.current_user_can_manage_team(target_team_id uuid)\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\n  select private.current_user_is_lwrpc_admin() or exists (\n    select 1\n    from public.user_roles ur\n    join public.teams t on t.id = target_team_id\n    where ur.user_id = (select auth.uid())\n      and ur.role in ('captain', 'club_pro', 'league_manager', 'commissioner')\n      and ur.member_id in (t.captain_member_id, t.co_captain_member_id,\n                           t.co_captain_2_member_id, t.club_pro_member_id)\n  )\n$function$\n"
    },
    {
      "name": "private.current_user_is_admin()",
      "definition": "CREATE OR REPLACE FUNCTION private.current_user_is_admin()\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\n  select exists (\r\n    select 1\r\n    from public.user_roles ur\r\n    where ur.user_id = auth.uid()\r\n      and ur.role in ('league_manager', 'commissioner')\r\n  )\r\n$function$\n"
    },
    {
      "name": "private.current_user_is_lwrpc_admin()",
      "definition": "CREATE OR REPLACE FUNCTION private.current_user_is_lwrpc_admin()\n RETURNS boolean\n LANGUAGE sql\n STABLE SECURITY DEFINER\n SET search_path TO ''\nAS $function$\n  select exists (\n    select 1\n    from public.user_roles ur\n    where ur.user_id = (select auth.uid())\n      and ur.role in ('league_manager', 'commissioner')\n  )\n$function$\n"
    }
  ],
